\name{rCandidates}
\alias{rCandidates}
\docType{data}
\title{MetaboAnnotatoR-generated example of ranked annotation candidates}
\description{
Ranked list of candidates from the Lipid Positive Library for feature 468.3095 m/z 82.92 s
from the example Lipid Positive (QC sample). This output was generated by function 
\code{rankScore()}. 
}
\details{
The example raw mzML file from which the data was extracted can be downloaded from zenodo:
\href{https://zenodo.org/records/17408169/files/Lipid_Positive_QC.mzML}{Lipid_Positive_QC.mzML}.
}
\usage{rCandidates}
\format{A list containing two elements: 1) a table with the ranked candidates and 
2) matched spectra of the ranked candidates.
}
\seealso{
\code{\link[MetaboAnnotatoR]{rankScore}}
}
\author{
Goncalo Graca
}
