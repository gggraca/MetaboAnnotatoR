\name{MESA_Xset}
\alias{MESA_Xset}
\title{MESA cohort subset Lipid Positive LC-MS samples processed using XCMS}
\description{
A random selection of 100 LC–MS MSE (all-ion fragmentation) chromatograms from a
Lipid Positive dataset from the MESA cohort that was processed in R using XCMS. 
}

\details{
A 100 sample subset of human serum LC–MS MSE datasets from the Multi-Ethnic Study of Atherosclerosis 
(\href{https://mesa-nhlbi.org/}{MESA}). Each sample was acquired on a Waters Acquity UPLC system connected 
to a Waters Xevo-G2 Q-ToF system operated in the MSE (all-ion fragmentation) mode.
The full details of the the processing can be found in the  
\href{https://pubs.acs.org/doi/10.1021/acs.analchem.1c03032}{MetaboAnnotatoR paper}. 
}

\format{An "xcmsSet" object.}

